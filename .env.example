# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# ".env" ist in .gitignore und darf NIEMALS committet werden.

# ---------------------------------------------------------------------------
# Tradovate
# ---------------------------------------------------------------------------
# Login-Daten deines Tradovate-Accounts
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=

# API-Zugangsdaten aus dem Tradovate API Access Portal
# (cid = Client ID / "API Key", sec = Client Secret)
TRADOVATE_CID=
TRADOVATE_SECRET=

# Frei waehlbarer, aber pro Rechner STABILER Identifier.
# Tradovate bindet Tokens an dieses Geraet - aendert er sich staendig,
# kommen Auth-Fehler ("Captcha required" / "Too many device registrations").
TRADOVATE_DEVICE_ID=

# App-Metadaten (frei waehlbar, werden im Auth-Request mitgeschickt)
TRADOVATE_APP_ID=ClaudeChartBot
TRADOVATE_APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Anthropic / Claude
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# FRED (optional, fuer das MCP-Tool get_event_risk)
# ---------------------------------------------------------------------------
# Kostenlos unter https://fred.stlouisfed.org/docs/api/api_key.html
# Wird NUR fuer die bereits veroeffentlichten Werte (Actual) gebraucht.
# Terminliste, Impact, Forecast und Previous kommen von Forex Factory und
# brauchen keinen Schluessel. Ohne FRED_API_KEY bleibt "actual" null.
FRED_API_KEY=

# ---------------------------------------------------------------------------
# Telegram (optional - ohne diese Werte faellt der Bot auf Konsole/Log zurueck)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Umgebung: "demo" oder "live"
# ---------------------------------------------------------------------------
# WICHTIG: "live" wird zusaetzlich durch allow_live_environment in der
# config.yaml UND durch das CLI-Flag --i-know-this-is-live abgesichert.
# Der Bot handelt nicht, aber "live" verbraucht dein echtes API-Kontingent.
TRADOVATE_ENV=demo
